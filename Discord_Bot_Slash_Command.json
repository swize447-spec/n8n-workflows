    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const text = item.json.output; // your joke string\n \n  // Replace backslashes first to avoid double-escaping them\n  let escaped = text.replace(/\\\\/g, '\\\\\\\\');\n \n  // Then escape double quotes\n  escaped = escaped.replace(/\"/g, '\\\\\"');\n \n  item.json.escapedContent = escaped;\n}\n \nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [576, 0],
      "id": "a13b071e-107c-4589-a235-3281fb36b1fc",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/webhooks/{{ \n$('Webhook').item.json.body.application_id }}/{{\n$('Webhook').item.json.body.token }}\n\n",
        "sendHeaders": true,
        "headerParameters": {
