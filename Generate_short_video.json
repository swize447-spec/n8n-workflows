    {
      "parameters": {
        "jsCode": "const scenes = $json.scenes;\n\nreturn [\n  {\n    json: {\n      scenes: scenes.map(scene => ({\n        text: scene.text,\n        visual: scene.visual\n      }))\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [112, 784],
      "id": "57b527a1-6d81-47e4-9be9-ef99956a7c94",
      "name": "Code in JavaScript",
      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "const inputData = $input.all();\nconst scenes = inputData[0].json.scenes;\n\nfunction extractKeyWords(visualDescription) {\n  const stopWords = new Set([\n    'a', 'an', 'the', 'of', 'to', 'in', 'on', 'at', 'for', 'with',\n    'its', 'or', 'and', 'but', 'is', 'are', 'was', 'were', 'be',\n    'been', 'being', 'have', 'has', 'had', 'do', 'does', 'did',\n    'will', 'would', 'could', 'should', 'may', 'might', 'shall',\n    'from', 'by', 'as', 'into', 'through', 'each', 'not', 'show',\n    'showing', 'footage', 'shot', 'clip', 'clips', 'perhaps', 'quick',\n    'transition', 'close-up', 'final', 'iconic', 'including'\n  ]);\n\n  const words = visualDescription\n    .toLowerCase()\n    .replace(/[^a-z\\s]/g, '')\n    .split(/\\s+/)\n    .filter(word => word.length > 2 && !stopWords.has(word));\n\n  return words.slice(0, 4).join(' ');\n}\n\nconst results = scenes.map((scene, index) => ({\n  sceneIndex: index + 1,\n  text: scene.text,\n  visual: scene.visual,\n  pexelsSearchTerm: extractKeyWords(scene.visual)\n}));\n\nreturn results.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
