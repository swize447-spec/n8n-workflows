      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [1216, 544],
      "id": "16c4cfc9-eea5-494e-a744-085345832883",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "let images = [];\nlet audioUrl = null;\n\nfor (const item of items) {\n  if (item.json.image_url) {\n    images.push(item.json.image_url);\n  }\n  if (item.json.secure_url) {\n    audioUrl = item.json.secure_url;\n  }\n}\n\nif (!images.length) throw new Error(\"No images found\");\nif (!audioUrl) throw new Error(\"No audio URL found\");\n\nconst totalDuration = 30;\nconst duration = totalDuration / images.length;\n\nconst clips = images.map((img, i) => ({\n  asset: { type: \"image\", src: img },\n  start: i * duration,\n  length: duration\n}));\n\nreturn [\n  {\n    json: {\n      timeline: {\n        tracks: [\n          { clips },\n          {\n            clips: [\n              {\n                asset: { type: \"audio\", src: audioUrl },\n                start: 0,\n                length: images.length * duration\n              }\n            ]\n          }\n        ]\n      },\n      output: {\n        format: \"mp4\",\n        resolution: \"hd\",\n        aspectRatio: \"9:16\"\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
